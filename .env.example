# Nightingale — repo-root environment.
#
# Copy to `.env` and fill in. This file is derived from the variables the code
# actually reads, not from memory:
#   grep -rhoE 'os\.environ\.get\("[A-Z_]+"' ai-service --include="*.py"
#
# TWO FILES, NOT ONE. This `.env` is loaded explicitly by the AI service
# (ai-service/main.py) and the collab server (collab-server/index.ts). Next.js
# reads env from its own project root, so `frontend/.env.local` is separate and
# required. Neither substitutes for the other, and a value put in the wrong one
# is inert rather than erroring.
#
# BLANK IS WORSE THAN ABSENT. `os.getenv(key, default)` returns "" for `KEY=`,
# which defeats every fallback. Comment a line out rather than emptying it.
#
# NEVER `source .env`. SUPABASE_JWT_JWK holds a JSON document and the shell
# strips its quotes; a real environment variable beats the file, so every AI
# endpoint then returns 503 with "SUPABASE_JWT_JWK is not valid JSON". Each
# service parses this file itself.

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: AI scribe ingestion, collab server, seeding, and
# the gated patient-message write. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# One of these verifies JWTs on the AI endpoints and the collab WebSocket.
# Prefer the JWK set: this project publishes ES256 keys and is migrating off the
# symmetric secret. Select by the token's `kid` — passing a whole set to
# from_jwk fails with an opaque JSON error.
SUPABASE_JWT_JWK=
SUPABASE_JWT_SECRET=

# --- AI -----------------------------------------------------------------------
# Without this every summarisation, highlight and patient-draft call fails.
# /ready reports it as groq_api_key=false and the service logs an explicit error.
GROQ_API_KEY=
# Per-attempt deadline. Kept under the browser's 25s AbortController so the
# server gives up first and the client renders a real timeout.
GROQ_TIMEOUT_SECONDS=20

# --- Ambient voice (optional, metered) ----------------------------------------
ELEVENLABS_API_KEY=
# Two switches are required to spend credits. Unset means deterministic mock
# transcripts, which is the default on purpose.
ELEVENLABS_LIVE_ENABLED=false

# --- Patient identity (OTP) ---------------------------------------------------
# Mixed into every stored OTP hash. Without it, a six-digit code hashes to a
# 10^6 rainbow table that a database leak would expose wholesale — so issuance
# refuses rather than storing unpeppered hashes. Falls back to
# SUPABASE_JWT_SECRET if unset; set it explicitly in production.
OTP_PEPPER=

# --- Messaging / delivery tracing ---------------------------------------------
# `mock` routes to the reserved-range simulator (+6580000001..4) which cannot
# contact a real number. Anything else, including unset, means NO provider:
# deliveries stay `queued` and render as not-confirmed, which is the honest
# state. There is deliberately no default.
MESSAGING_PROVIDER=mock
MESSAGING_PROVIDER_API_KEY=
# Signs the delivery-status webhook. The endpoint cannot require a JWT (a
# provider has none), so this is the only thing standing between the callback
# and a forged "delivered". Unset fails closed with 503.
MESSAGING_WEBHOOK_SECRET=
# Where the mock provider posts its own callback. Must be reachable from the
# AI service itself.
AI_SERVICE_SELF_URL=http://localhost:8000
MOCK_WEBHOOK_DELAY_SECONDS=0.5

# --- CORS ---------------------------------------------------------------------
# Browser origins permitted to call the AI service. Unset uses the built-in list,
# which already includes the production Vercel URL and both localhost spellings.
# Setting this REPLACES that list rather than extending it.
#
# Never "*": combined with credentials it is rejected by every browser, and this
# service is called with an Authorization header.
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# --- Services -----------------------------------------------------------------
HOCUSPOCUS_PORT=1234
LOG_LEVEL=INFO
